if(NOT DEFINED MDSLC_OBJDUMP OR NOT DEFINED MDSLC_NM OR
   NOT DEFINED MDSLC_RUNTIME)
  message(FATAL_ERROR "MDSLC_OBJDUMP, MDSLC_NM, and MDSLC_RUNTIME are required")
endif()

execute_process(
  COMMAND "${MDSLC_NM}" --defined-only "${MDSLC_RUNTIME}"
  RESULT_VARIABLE MDSLC_NM_STATUS
  OUTPUT_VARIABLE MDSLC_SYMBOLS
  ERROR_VARIABLE MDSLC_NM_ERROR
)
if(NOT MDSLC_NM_STATUS EQUAL 0)
  message(FATAL_ERROR "nm failed for ${MDSLC_RUNTIME}: ${MDSLC_NM_ERROR}")
endif()
string(REGEX MATCH
  "[0-9A-Fa-f]+[ \t]+[A-Za-z][ \t]+([^ \r\n]*compiler_vectorized_gemm[^ \r\n]*)"
  MDSLC_VECTOR_SYMBOL_LINE
  "${MDSLC_SYMBOLS}"
)
set(MDSLC_VECTOR_SYMBOL "${CMAKE_MATCH_1}")
if(MDSLC_VECTOR_SYMBOL STREQUAL "")
  message(FATAL_ERROR
    "compiler-vectorized GEMM symbol is absent from ${MDSLC_RUNTIME}")
endif()

execute_process(
  COMMAND "${MDSLC_OBJDUMP}" -d -M intel
          "--disassemble=${MDSLC_VECTOR_SYMBOL}" "${MDSLC_RUNTIME}"
  RESULT_VARIABLE MDSLC_OBJDUMP_STATUS
  OUTPUT_VARIABLE MDSLC_VECTOR_DISASSEMBLY
  ERROR_VARIABLE MDSLC_OBJDUMP_ERROR
)
if(NOT MDSLC_OBJDUMP_STATUS EQUAL 0)
  message(FATAL_ERROR
    "objdump failed for ${MDSLC_RUNTIME}: ${MDSLC_OBJDUMP_ERROR}")
endif()

string(TOLOWER "${MDSLC_VECTOR_DISASSEMBLY}" MDSLC_VECTOR_DISASSEMBLY)
string(FIND "${MDSLC_VECTOR_DISASSEMBLY}" "ymm" MDSLC_YMM_INSTRUCTION)
string(REGEX MATCH "vfmadd[0-9]*ps" MDSLC_PACKED_FMA
  "${MDSLC_VECTOR_DISASSEMBLY}")
if(MDSLC_YMM_INSTRUCTION EQUAL -1 OR MDSLC_PACKED_FMA STREQUAL "")
  message(FATAL_ERROR
    "compiler-vectorized GEMM must contain function-local YMM packed FMA")
endif()
