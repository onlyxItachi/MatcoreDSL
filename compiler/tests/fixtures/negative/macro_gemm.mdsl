#include <matcore/mdsl.h>

namespace md = matcore::mdsl;
#define RUN_GEMM(C, A, B) md::gemm(md::out(C), A, B)

int main() {
  float values[3] = {1, 1, 0};
  md::matrix_view a{values, 1, 1};
  md::matrix_view b{values + 1, 1, 1};
  md::matrix_view c{values + 2, 1, 1};
  RUN_GEMM(c, a, b);
  return 0;
}
