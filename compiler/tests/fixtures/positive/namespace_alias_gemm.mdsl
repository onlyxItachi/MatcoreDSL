#include <matcore/mdsl.h>

namespace md = matcore::mdsl;

int main() {
  float a_data[1] = {3};
  float b_data[1] = {4};
  float c_data[1] = {};
  md::matrix_view a{a_data, 1, 1};
  md::matrix_view b{b_data, 1, 1};
  md::matrix_view c{c_data, 1, 1};
  md::gemm(md::out(c), a, b,
           md::policy{.target = md::target::cpu,
                      .fallback = md::fallback::error});
  return c_data[0] == 12 ? 0 : 1;
}
