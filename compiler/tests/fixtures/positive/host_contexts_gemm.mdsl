#include <matcore/mdsl.h>

namespace md = matcore::mdsl;

namespace user {

void run_free(md::matrix_view &c, const md::matrix_view &a,
              const md::matrix_view &b) {
  md::gemm(md::out(c), a, b,
           md::policy{.target = md::target::cpu,
                      .fallback = md::fallback::error});
}

class runner {
public:
  void run(md::matrix_view &c, const md::matrix_view &a,
           const md::matrix_view &b) {
    md::gemm(md::out(c), a, b);
  }
};

} // namespace user

int main() {
  float storage[3] = {2, 5, 0};
  md::matrix_view a{storage, 1, 1};
  md::matrix_view b{storage + 1, 1, 1};
  md::matrix_view c{storage + 2, 1, 1};
  user::run_free(c, a, b);
  user::runner{}.run(c, a, b);
  return storage[2] == 10 ? 0 : 1;
}
