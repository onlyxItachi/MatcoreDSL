#include <matcore/region.h>
#include <bit>
#include <cerrno>
#include <cfenv>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <vector>
#include <xmmintrin.h>

// Private host expectation only; neither mode changes the admitted region.
#ifndef MDSLC_EXPECT_COMBINED_WORK_REFUSAL
#define MDSLC_EXPECT_COMBINED_WORK_REFUSAL 0
#endif
#if MDSLC_EXPECT_COMBINED_WORK_REFUSAL != 0 && MDSLC_EXPECT_COMBINED_WORK_REFUSAL != 1
#error "MDSLC_EXPECT_COMBINED_WORK_REFUSAL must be 0 or 1"
#endif

namespace md = matcore::mdsl;
static constexpr unsigned second_gemm_line = __LINE__ + 9;
MATCORE_REGION md::Result strict_fused_pipeline(md::Storage A, md::Storage B,
    md::Storage D, md::Storage Prefix, md::Storage E, md::Shape m) noexcept {
  auto a = md::read(A, m, 32);
  auto b = md::read(B, 32, 64);
  auto d = md::read(D, 64, 32);
  md::publish(a, Prefix);
  md::observe(Prefix);
  auto c = md::gemm(a, b, md::Numerics::strict_f32);
  auto e = md::gemm(c, d, md::Numerics::strict_f32);
  md::publish(e, E);
  return md::complete();
}

// Keep the direct protected call in an ordinary no-math context for --program.
static md::Result invoke(md::Storage a, md::Storage b, md::Storage d,
                         md::Storage prefix, md::Storage e, md::Shape m) noexcept {
  return strict_fused_pipeline(a, b, d, prefix, e, m);
}

#pragma STDC FENV_ACCESS ON
#pragma STDC FP_CONTRACT OFF
namespace {
unsigned checks = 0, failures = 0;
void check(bool condition, const char *label) {
  ++checks;
  if (!condition) { ++failures; std::fprintf(stderr, "FAIL work cap: %s\n", label); }
}
md::Observation run(md::Shape m, bool expect_refusal) {
  std::vector<float> a(m * 32, 1.0f), b(32 * 64, 1.0f), d(64 * 32, 1.0f);
  std::vector<float> prefix(a.size() + 2, -701.0f), output(a.size() + 2, -801.0f);
  md::Observation retained;
  std::fenv_t original{}, before{}, after{};
  const int original_errno = errno;
  check(std::fegetenv(&original) == 0, "capture original FP state");
  check(std::fesetround(FE_DOWNWARD) == 0 &&
        std::feraiseexcept(FE_INEXACT | FE_UNDERFLOW) == 0, "hostile caller FP state");
  _mm_setcsr(_mm_getcsr() | 0x8040U);
  check(std::fegetenv(&before) == 0, "capture modified whole FP state");
  const auto before_mxcsr = _mm_getcsr();
  errno = EDOM;
  {
    auto result = invoke(
        {a.data(), m, 32, a.size(), md::Access::read_only},
        {b.data(), 32, 64, b.size(), md::Access::read_only},
        {d.data(), 64, 32, d.size(), md::Access::read_only},
        {prefix.data() + 1, m, 32, a.size(), md::Access::read_write},
        {output.data() + 1, m, 32, a.size(), md::Access::read_write}, m);
    const int after_errno = errno;
    const auto after_mxcsr = _mm_getcsr();
    check(std::fegetenv(&after) == 0 && std::memcmp(&before, &after, sizeof(before)) == 0 &&
          before_mxcsr == after_mxcsr && after_errno == EDOM,
          "success/cap refusal preserves whole caller FP controls, status and errno");
    check(std::fesetenv(&original) == 0, "restore fixture FP state");
    errno = original_errno;
    check(result.publication_count() == (expect_refusal ? 1U : 2U) &&
          result.observation_count() == 1, "exact publication/observation prefix");
    retained = result.observation(0);
    check(retained.valid() && retained.rows() == m && retained.columns() == 32,
          "earlier owning observation dimensions");
    if (expect_refusal) {
      check(!result.ok() && result.error() == md::Error::candidate_incompatible &&
            result.failed_frontier() == 7 && result.completed_frontier() == 6 &&
            result.completed_effect_frontier() == 5, "shared-only work cap rejects at f2");
      const auto location = result.failure_location();
      check(location.file && std::strcmp(location.file, __FILE__) == 0 &&
            location.line == second_gemm_line && location.column == 12,
            "cap failure retains original second-GEMM physical source identity");
    } else {
      check(result.ok() && result.error() == md::Error::ok && result.failed_frontier() == 0 &&
            result.completed_frontier() == 9 && result.completed_effect_frontier() == 8,
            "legal original/boundary computation completes every frontier");
    }
    for (std::size_t i = 0; i < a.size(); ++i) {
      check(prefix[i + 1] == 1.0f, "earlier publication is retained");
      const float expected = expect_refusal ? -801.0f : 2048.0f;
      check(std::bit_cast<std::uint32_t>(output[i + 1]) ==
            std::bit_cast<std::uint32_t>(expected), "final output exact or unchanged sentinel");
    }
  }
  check(prefix.front() == -701.0f && prefix.back() == -701.0f &&
        output.front() == -801.0f && output.back() == -801.0f, "host publication canaries");
  for (float item : a) check(item == 1.0f, "A immutable");
  for (float item : b) check(item == 1.0f, "B immutable");
  for (float item : d) check(item == 1.0f, "D immutable");
  prefix[1] = -999.0f;
  if (retained.valid())
    for (std::size_t i = 0; i < a.size(); ++i)
      check(retained.data()[i] == 1.0f, "owning prefix survives Result destruction/host mutation");
  return retained;
}
} // namespace

int main() {
  // M64 is exactly 2^18 combined work. M65 is 266240 shared work, while
  // each original GEMM is only 133120 work and both output grids are legal.
  auto boundary = run(64, false);
  auto over_cap = run(65, MDSLC_EXPECT_COMBINED_WORK_REFUSAL != 0);
  check(boundary.valid() && boundary.rows() == 64 && boundary.columns() == 32 &&
        boundary.data()[0] == 1.0f && over_cap.valid(),
        "old owning result remains intact after the later over-cap invocation");
  std::printf("GPU fused pair work cap: %u checks; %u failures; boundary executed; %s\n",
              checks, failures, MDSLC_EXPECT_COMBINED_WORK_REFUSAL
              ? "over-cap refused at f2" : "over-cap executed");
  return failures ? 1 : 0;
}
