#include <matcore/region.h>
#include <cstdio>
#include <cstring>
#include <vector>
namespace md = matcore::mdsl;

MATCORE_REGION
md::Result pipeline(md::Storage A, md::Storage B, md::Storage D,
                    md::Storage C, md::Storage E, md::Shape n) noexcept {
  auto a = md::read(A, 1, 1);
  auto b = md::read(B, 1, 1);
  auto c = md::gemm(a, b, md::Numerics::strict_f32);
  md::publish(c, C);
  md::observe(C);
  auto d = md::read(D, 1, n);
  auto e = md::gemm(c, d, md::Numerics::strict_f32);
  md::publish(e, E);
  return md::complete();
}

int main(int argc, char **argv) {
  const bool unavailable = argc == 2 && std::strcmp(argv[1], "--unavailable") == 0;
  constexpr md::Shape n = 65536; // legal math, outside this GPU recipe's contract
  float a = 2, b = 3, c = -11;
  std::vector<float> d(n, 4), e(n, -19);
  auto result = pipeline({&a,1,1,1}, {&b,1,1,1}, {d.data(),1,n,n},
      {&c,1,1,1,md::Access::read_write}, {e.data(),1,n,n,md::Access::read_write}, n);
  unsigned failures = 0;
  auto check = [&](bool value) { failures += !value; };
  check(!result.ok());
  check(result.error() == (unavailable ? md::Error::candidate_unavailable
                                      : md::Error::candidate_incompatible));
  check(result.failed_frontier() == (unavailable ? 3 : 7));
  check(result.completed_frontier() == (unavailable ? 2 : 6));
  check(result.completed_effect_frontier() == (unavailable ? 0 : 5));
  check(result.publication_count() == (unavailable ? 0 : 1));
  check(result.observation_count() == (unavailable ? 0 : 1));
  check(c == (unavailable ? -11 : 6));
  if (!unavailable) {
    const auto observed = result.observation(0);
    check(observed.valid() && observed.data()[0] == 6);
  }
  for (float value : e) check(value == -19);
  check(a == 2 && b == 3);
  std::printf("GPU source failure frontier: %u failures\n", failures);
  return failures ? 1 : 0;
}
