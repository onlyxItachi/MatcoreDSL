// Independently authored source/effect and strict-arithmetic oracle. No timing
// or implementation-identity claim follows from successful mathematics alone.
#include "math_helper.h"
#include <algorithm>
#include <bit>
#include <cerrno>
#include <cfenv>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <limits>
#include <string_view>
#include <vector>

namespace md = matcore::mdsl;
MATCORE_REGION
md::Result source_pattern_pipeline(md::Storage A, md::Storage B,
    md::Storage C, md::Storage D, md::Storage E,
    md::Shape M, md::Shape K, md::Shape N, md::Shape P) noexcept {
  auto a = md::read(A, M, K);
  auto b = md::read(B, K, N);
  auto old = md::read(C, M, N);
  auto first = source_pattern_math::product(a, b);
  md::publish(first, C);
  md::observe(C);
  auto late = md::read(D, N, P);
  auto second = source_pattern_math::product(first, late);
  md::publish(second, E);
  md::observe(E);
  md::publish(old, C);
  md::observe(C);
  return md::complete();
}

// An ordinary no-math host call retains the exact source entry ABI even when
// the caller below establishes a nondefault floating-point environment.
static md::Result invoke(md::Storage a, md::Storage b, md::Storage c,
    md::Storage d, md::Storage e, md::Shape m, md::Shape k,
    md::Shape n, md::Shape p) noexcept {
  return source_pattern_pipeline(a, b, c, d, e, m, k, n, p);
}

#pragma STDC FENV_ACCESS ON
#pragma STDC FP_CONTRACT OFF
namespace {
unsigned checks = 0, failures = 0, cases = 0;
bool corrupt = false;
void check(bool condition, const char *label) {
  ++checks;
  if (!condition && failures++ < 12) std::fprintf(stderr, "FAIL source pattern: %s\n", label);
}
bool same(float a, float b) {
  return (std::isnan(a) && std::isnan(b)) ||
      std::bit_cast<std::uint32_t>(a) == std::bit_cast<std::uint32_t>(b);
}
std::vector<float> product(const float *a, const float *b,
    md::Shape m, md::Shape k, md::Shape n) {
  std::vector<float> c(static_cast<std::size_t>(m * n));
  if (c.empty()) return c;
  for (md::Shape i = 0; i < m; ++i)
    for (md::Shape j = 0; j < n; ++j) {
      volatile float accumulator = 0.0F;
      for (md::Shape q = 0; q < k; ++q) {
        volatile float term = a[i * k + q] * b[q * n + j];
        accumulator = accumulator + term;
      }
      c[static_cast<std::size_t>(i * n + j)] = accumulator;
    }
  return c;
}
md::Storage storage(std::vector<float> &v, md::Shape rows, md::Shape columns,
    md::Access access = md::Access::read_only) {
  return {v.empty() ? nullptr : v.data(), rows, columns, v.size(), access};
}
void values(const float *actual, const std::vector<float> &expected, const char *label) {
  for (std::size_t i = 0; i < expected.size(); ++i) check(same(actual[i], expected[i]), label);
}
void observe(const md::Result &result, unsigned index, md::Shape rows,
    md::Shape columns, const std::vector<float> &expected) {
  const auto item = result.observation(index);
  check(item.valid() && item.rows() == rows && item.columns() == columns,
        "owning observation identity/shape");
  if (item.valid()) values(item.data(), expected, "owning observation contents");
}
void run(md::Shape m, md::Shape k, md::Shape n, md::Shape p,
    std::vector<float> a, std::vector<float> b, unsigned failure = 0,
    bool input_alias = false, bool late_alias = false, bool nondefault_fp = false) {
  ++cases;
  const auto original_a = a, original_b = b;
  // The one-cell shifted late descriptor overlaps C, including its last
  // publication cell and a distinct spill cell. It must read after publish.
  const std::size_t late_count = static_cast<std::size_t>(n * p);
  const std::size_t output_count = static_cast<std::size_t>(m * n);
  std::vector<float> c(std::max(output_count, late_alias ? late_count + 1 : 0) + 2, 17.0F);
  std::vector<float> d(late_count), e(static_cast<std::size_t>(m * p) + 2, -29.0F);
  for (std::size_t i = 0; i < d.size(); ++i) d[i] = float(int((i * 3 + 1) % 7) - 3) * 0.125F;
  const std::vector<float> old(c.begin() + 1, c.begin() + 1 + output_count);
  const auto untouched = e;
  auto *a_data = a.empty() ? nullptr : a.data();
  auto *b_data = input_alias ? a_data : (b.empty() ? nullptr : b.data());
  const auto first = product(a_data, b_data, m, k, n);
  auto expected_c = c;
  std::copy(first.begin(), first.end(), expected_c.begin() + 1);
  const auto *late_data = late_alias ? expected_c.data() + 2 : d.data();
  const auto second = product(first.data(), late_data, m, n, p);
  auto late = late_alias
      ? md::Storage{c.data() + 2, n, p, c.size() - 2, md::Access::read_only}
      : storage(d, n, p);
  if (failure == 1) late.capacity_elements = late_count ? late_count - 1 : 0;
  auto destination = md::Storage{e.data() + 1, m, p, e.size() - 2,
      failure == 2 ? md::Access::read_only : md::Access::read_write};
  std::fenv_t saved{};
  int saved_errno = errno, expected_rounding = FE_TONEAREST, expected_flags = 0;
  if (nondefault_fp) {
    check(std::fegetenv(&saved) == 0 && std::fesetround(FE_DOWNWARD) == 0 &&
              std::feraiseexcept(FE_INEXACT | FE_UNDERFLOW) == 0,
          "nondefault caller FP controls established");
    expected_rounding = std::fegetround();
    expected_flags = std::fetestexcept(FE_ALL_EXCEPT);
    errno = EDOM;
  }
  auto result = invoke(storage(a, m, k),
      {b_data, k, n, input_alias ? a.size() : b.size(), md::Access::read_only},
      {c.data() + 1, m, n, c.size() - 2, md::Access::read_write}, late,
      destination, m, k, n, p);
  if (nondefault_fp) {
    check(errno == EDOM && std::fegetround() == expected_rounding &&
              std::fetestexcept(FE_ALL_EXCEPT) == expected_flags,
          "candidate restores caller errno and FP controls/status");
    check(std::fesetenv(&saved) == 0, "restore fixture FP environment");
    errno = saved_errno;
  }
  if (corrupt && !first.empty()) {
    c[1] = 0x1.abcdefp20F;
    e[1] = 0x1.abcdefp20F;
  }
  values(a.data(), original_a, "A immutable and bounded");
  values(b.data(), original_b, "B immutable and bounded");
  check(same(c.front(), 17.0F) && same(c.back(), 17.0F) &&
            same(e.front(), -29.0F) && same(e.back(), -29.0F), "output canaries");
  if (failure) {
    check(!result && result.error() == (failure == 1 ? md::Error::insufficient_capacity : md::Error::access_denied),
          "ordered late failure kind");
    check(result.publication_count() == 1 && result.observation_count() == 1,
          "late failure retains exactly prior publication/observation");
    check(result.failed_frontier() == (failure == 1 ? 7U : 9U) &&
              result.completed_frontier() + 1 == result.failed_frontier() &&
              result.completed_effect_frontier() == 6 &&
              result.failure_location().file && result.failure_location().line &&
              result.failure_location().column,
          "late failure retains original source/effect frontier");
    values(c.data() + 1, first, "earlier publication remains visible");
    values(e.data(), untouched, "unreached publication leaves E unchanged");
    observe(result, 0, m, n, first);
    return;
  }
  check(result.ok() && result.publication_count() == 3 && result.observation_count() == 3 &&
            result.completed_frontier() == 13 && result.completed_effect_frontier() == 12,
        "complete original source/effect trace");
  values(c.data() + 1, old, "immutable prepublication snapshot is republished");
  values(e.data() + 1, second, "second GEMM sees correct late read");
  std::fill(c.begin() + 1, c.end() - 1, 101.0F);
  std::fill(e.begin() + 1, e.end() - 1, 103.0F);
  observe(result, 0, m, n, first);
  observe(result, 1, m, p, second);
  observe(result, 2, m, n, old);
}
void extreme_empty() {
  ++cases;
  const auto huge = static_cast<md::Shape>(std::numeric_limits<std::int64_t>::max());
  auto result = invoke({nullptr, huge, 0, 0}, {nullptr, 0, 0, 0},
      {nullptr, huge, 0, 0, md::Access::read_write}, {nullptr, 0, 0, 0},
      {nullptr, huge, 0, 0, md::Access::read_write}, huge, 0, 0, 0);
  check(result.ok() && result.publication_count() == 3 && result.observation_count() == 3,
        "INT64_MAX legal empty shapes bypass tile increments");
  auto rejected = invoke({nullptr, huge, 0, 0}, {nullptr, 0, 2, 0},
      {nullptr, huge, 2, 0, md::Access::read_write}, {nullptr, 2, 0, 0},
      {nullptr, huge, 0, 0, md::Access::read_write}, huge, 0, 2, 0);
  check(!rejected && rejected.error() == md::Error::extent_overflow &&
            rejected.failed_frontier() == 3 && rejected.completed_frontier() == 2 &&
            rejected.publication_count() == 0 && rejected.observation_count() == 0,
        "original checked byte-extent failure precedes any tile invocation");
}
}
int main(int argc, char **argv) {
  if (argc == 2 && std::string_view(argv[1]) == "--corrupt-output") corrupt = true;
  else if (argc == 2 && std::string_view(argv[1]) == "--host-oob") {
    auto *data = new float[1]{1};
    volatile int index = 2;
    const int result = int(data[index]);
    delete[] data;
    return result;
  } else if (argc != 1) return 2;
  std::fenv_t caller;
  if (std::fegetenv(&caller) || std::fesetenv(FE_DFL_ENV)) return 2;
  for (md::Shape m : {2ULL, 3ULL, 4ULL, 5ULL, 6ULL, 7ULL, 11ULL})
    for (md::Shape n : {2ULL, 3ULL, 4ULL, 5ULL, 6ULL, 7ULL, 11ULL}) {
      std::vector<float> a(static_cast<std::size_t>(m * 3)), b(static_cast<std::size_t>(3 * n));
      for (std::size_t i = 0; i < a.size(); ++i) a[i] = float(int((7 * i + 3) % 13) - 6) * 0.125F;
      for (std::size_t i = 0; i < b.size(); ++i) b[i] = float(int((3 * i + 1) % 11) - 5) * 0.0625F;
      run(m, 3, n, 7, a, b);
    }
  for (md::Shape k : {31ULL, 32ULL, 33ULL, 63ULL, 64ULL, 65ULL})
    run(6, k, 17, 7, std::vector<float>(static_cast<std::size_t>(6 * k), 0.125F),
        std::vector<float>(static_cast<std::size_t>(k * 17), 0.5F));
  // Full tiles and tails distinguish increasing K from 32-term partial sums.
  std::vector<float> ordered(65 * 65, 0.0F);
  for (unsigned row = 0; row < 65; ++row) {
    ordered[row * 65] = 0x1p25F; ordered[row * 65 + 31] = 1;
    ordered[row * 65 + 32] = -0x1p25F; ordered[row * 65 + 33] = 1;
    ordered[row * 65 + 64] = 2;
  }
  check(same(product(ordered.data(), std::vector<float>(65, 1).data(), 1, 65, 1)[0], 3.0F),
        "ordered-K independent counteroracle");
  run(65, 65, 129, 7, ordered, std::vector<float>(65 * 129, 1.0F));
  std::vector<float> fma_a(130), fma_b(2 * 129, 1.0F);
  for (unsigned row = 0; row < 65; ++row) {
    fma_a[row * 2] = -1; fma_a[row * 2 + 1] = 0x1.000002p0F;
  }
  for (unsigned j = 0; j < 129; ++j) fma_b[129 + j] = 0x1.fffffcp-1F;
  check(std::fma(0x1.000002p0F, 0x1.fffffcp-1F, -1.0F) != 0.0F,
        "FMA counteroracle discriminates separate arithmetic");
  run(65, 2, 129, 7, fma_a, fma_b);
  run(65, 2, 129, 7, fma_a, fma_b, 0, false, false, true);
  const float inf = std::numeric_limits<float>::infinity();
  const float nan = std::numeric_limits<float>::quiet_NaN();
  run(6, 1, 7, 5, std::vector<float>(6, 0), {inf, -inf, nan, -0.0F, 1, -1, 0});
  run(6, 1, 7, 5, std::vector<float>(6, 0x1p-126F), {0.5F, -0.5F, 1, -1, 0, 2, -2});
  run(3, 3, 3, 2, {1, 2, 3, 4, 5, 6, 7, 8, 9}, std::vector<float>(9), 0, true);
  run(3, 3, 5, 2, std::vector<float>(9, 2), std::vector<float>(15, 3), 0, false, true);
  run(3, 3, 5, 2, std::vector<float>(9, 2), std::vector<float>(15, 3), 1);
  run(3, 3, 5, 2, std::vector<float>(9, 2), std::vector<float>(15, 3), 2);
  run(3, 0, 5, 2, {}, {});
  run(0, 3, 5, 2, {}, std::vector<float>(15, 1));
  run(3, 3, 0, 2, std::vector<float>(9, 1), {});
  extreme_empty();
  if (std::fesetenv(&caller)) return 2;
  std::printf("Source pattern semantic oracle: %u cases; %u checks; %u failures; host_sanitized=%d\n",
      cases, checks, failures,
#if __has_feature(address_sanitizer)
      1
#else
      0
#endif
      );
  return failures ? 1 : 0;
}
