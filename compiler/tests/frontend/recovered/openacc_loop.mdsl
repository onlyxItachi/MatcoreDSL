#include <cstddef>

void openacc_loop_gemm(float *c, const float *a, const float *b,
                       std::size_t m, std::size_t n, std::size_t k) {
#pragma acc parallel loop
  for (std::size_t i = 0; i < m; ++i) {
    for (std::size_t j = 0; j < n; ++j) {
      float acc = 0.0F;
      for (std::size_t p = 0; p < k; ++p) {
        acc += a[i * k + p] * b[p * n + j];
      }
      c[i * n + j] = acc;
    }
  }
}
