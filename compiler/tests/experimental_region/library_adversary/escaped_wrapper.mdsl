#include <matcore/region.h>
namespace md = matcore::mdsl;
namespace library {
#include "shared_body.h"
}

// This ordinary host function is not part of the selected expansion closure.
md::Value ordinary_host_wrapper(md::Value a, md::Value b) {
  return library::product(a, b);
}

MATCORE_REGION md::Result library_region(
    md::Storage A, md::Storage B, md::Storage C,
    md::Shape M, md::Shape K, md::Shape N) noexcept {
  auto a = md::read(A, M, K);
  auto b = md::read(B, K, N);
  auto c = library::product(a, b);
  md::publish(c, C);
  return md::complete();
}
int main() { return 0; }
