#include "api.h"
MATCORE_REGION md::Result permissive_first(md::Storage a, md::Storage b,
                                         md::Storage c) noexcept {
  auto av = md::read(a, 4, 2);
  auto bv = md::read(b, 2, 8);
  auto cv = md::gemm(av, bv, md::Numerics::reassociate_f32);
  md::publish(cv, c);
  md::observe(c);
  return md::complete();
}
