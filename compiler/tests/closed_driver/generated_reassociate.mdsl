#include <matcore/region.h>
#include <array>
#include <bit>
#include <cerrno>
#include <cfenv>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <vector>
#include <xmmintrin.h>

// Host oracle FP pragmas follow the region; they are not inherited region
// attributes or a way to change the source numerical profile.
namespace md = matcore::mdsl;

MATCORE_REGION md::Result reassociate_pipeline(md::Storage a, md::Storage b, md::Storage first,
                               md::Storage late, md::Storage last,
                               md::Shape m, md::Shape n, md::Shape k,
                               md::Shape late_k, md::Shape late_columns, md::Shape strict_second,
                               md::Shape rhs_carry) noexcept {
  auto av = md::read(a, m, k);
  auto bv = md::read(b, k, n);
  auto cv = md::gemm(av, bv, md::Numerics::reassociate_f32);
  md::publish(cv, first);
  md::observe(first);
  auto dv = md::read(late, late_k, late_columns);
  if (strict_second == 1) {
    auto ev = md::gemm(cv, dv, md::Numerics::strict_f32);
    md::publish(ev, last);
  } else {
    if (rhs_carry == 1) {
      auto ev = md::gemm(dv, cv, md::Numerics::reassociate_f32);
      md::publish(ev, last);
    } else {
      auto ev = md::gemm(cv, dv, md::Numerics::reassociate_f32);
      md::publish(ev, last);
    }
  }
  md::observe(last);
  return md::complete();
}

#pragma STDC FENV_ACCESS ON
#pragma STDC FP_CONTRACT OFF
namespace {
int checks=0, failures=0;
void check(bool value, const char *what) {
  ++checks;
  if (!value) { ++failures; std::cerr << "FAIL: " << what << '\n'; }
}
bool same(float a,float b) {
  return (std::isnan(a) && std::isnan(b)) ||
         std::bit_cast<std::uint32_t>(a)==std::bit_cast<std::uint32_t>(b);
}
std::vector<float> multiply(const std::vector<float> &a,const std::vector<float> &b,
                            std::size_t m,std::size_t n,std::size_t k) {
  std::vector<float> result(m*n);
  for (std::size_t i=0;i<m;++i)
    for (std::size_t j=0;j<n;++j) {
      double value=0;
      for (std::size_t p=0;p<k;++p) value += double(a[i*k+p])*double(b[p*n+j]);
      result[i*n+j]=static_cast<float>(value);
    }
  return result;
}
bool allowedPair(float result,float a,float b,float c,float d) {
  const float p=a*b,q=c*d,z=0,zp=z+p,zq=z+q,pq=p+q;
  for(float possible : std::array<float,9>{zp+q,zq+p,z+pq,
      std::fma(a,b,zq),std::fma(c,d,zp),std::fma(a,b,std::fma(c,d,z)),
      std::fma(c,d,std::fma(a,b,z)),z+std::fma(a,b,q),z+std::fma(c,d,p)})
    if(same(result,possible)) return true;
  return false;
}
void run(const char *policy,std::size_t m,std::size_t n,std::size_t k,
         bool strictSecond,bool aliasLate,bool rhsCarry,bool shapeFailure,
         bool fmaCase=false) {
  const bool generated=std::strcmp(policy,"generated-reassociate")==0;
  const bool provider=std::strcmp(policy,"openblas")==0;
  const bool incompatible=generated || provider || std::strcmp(policy,"existing-native")==0;
  const bool hardware=__builtin_cpu_supports("avx2") && __builtin_cpu_supports("fma");
  const std::size_t lateK=shapeFailure ? n+1 : (rhsCarry ? m : n);
  const std::size_t lateColumns=rhsCarry ? m : n;
  const std::size_t outM=rhsCarry ? lateK : m;
  std::vector<float> a(m*k),b(k*n),first(m*n+2,-777),late(lateK*lateColumns),last(outM*n+2,-888);
  for(std::size_t i=0;i<a.size();++i) a[i]=float(int(i%7)-3);
  for(std::size_t i=0;i<b.size();++i) b[i]=float(int(i%5)-2);
  for(std::size_t i=0;i<late.size();++i) late[i]=float(int(i%3)-1);
  if(fmaCase) {
    for(std::size_t i=0;i<m;++i) { a[2*i]=-1; a[2*i+1]=0x1.000002p0F; }
    for(std::size_t j=0;j<n;++j) { b[j]=1; b[n+j]=0x1.fffffep-1F; }
  }
  const auto savedA=a,savedB=b;
  const auto expectedFirst=multiply(a,b,m,n,k);
  // Alias late input with the just-published result only for square output.
  const auto expectedLate=aliasLate ? expectedFirst : late;
  const auto expectedLast=shapeFailure ? std::vector<float>{} :
      (rhsCarry ? multiply(expectedLate,expectedFirst,lateK,n,m)
                : multiply(expectedFirst,expectedLate,m,n,n));
  md::Observation retained;
  {
    std::fenv_t old;
    std::fegetenv(&old);
    std::fesetround(FE_DOWNWARD);
    std::feraiseexcept(FE_INEXACT|FE_UNDERFLOW);
    _mm_setcsr(_mm_getcsr()|0x8040U);
    const auto mxcsr=_mm_getcsr();
    std::fenv_t before{},after{};
    std::fegetenv(&before);
    errno=EDOM;
    auto result=reassociate_pipeline(
      {a.data(),m,k,a.size(),md::Access::read_write},
      {b.data(),k,n,b.size(),md::Access::read_write},
      {first.data()+1,m,n,m*n,md::Access::read_write},
      {aliasLate ? first.data()+1 : late.data(),lateK,lateColumns,lateK*lateColumns,md::Access::read_write},
      {last.data()+1,outM,n,outM*n,md::Access::read_write},m,n,k,lateK,lateColumns,strictSecond,rhsCarry);
    std::fegetenv(&after);
    check(errno==EDOM && mxcsr==_mm_getcsr() &&
          before.__control_word==after.__control_word && before.__status_word==after.__status_word,
          "source call restores errno and complete FP environment");
    std::fesetenv(&old);
    if(generated && !hardware) {
      check(result.error()==md::Error::candidate_unavailable && result.failed_frontier()==3 &&
            result.publication_count()==0 && result.observation_count()==0,
            "physical unsupported candidate refuses before any effects, including empties");
      return;
    }
    const bool refused=strictSecond && incompatible;
    const bool failed=refused || shapeFailure;
    check(bool(result)==!failed,"source expected success/failure");
    check(result.publication_count()==(failed ? 1U : 2U) &&
          result.observation_count()==(failed ? 1U : 2U),"exact publication/observation counts");
    if(failed) {
      // Static then-arm numbering is retained; the shape failure dominates the
      // numerical/candidate gate at this same GEMM.
      check(result.error()==(shapeFailure ? md::Error::shape_mismatch : md::Error::candidate_incompatible) &&
            result.failed_frontier()==8 && result.completed_frontier()==6 &&
            result.completed_effect_frontier()==5,"exact late GEMM failure prefix");
      check(result.failure_location().line==29 && result.failure_location().column==15,
            "strict/shape failure names original source GEMM");
      for(std::size_t i=0;i<outM*n;++i) check(last[1+i]==-888,"failed candidate does not publish");
    }
    retained=result.observation(0);
    for(std::size_t i=0;i<m*n;++i) {
      if(fmaCase) {
        const float fused=std::fma(a[1],b[n],-1.0F);
        const float separate=0.0F;
        if(provider || std::strcmp(policy,"existing-native")==0)
          check(allowedPair(first[i+1],a[0],b[0],a[1],b[n]),"legacy/provider legal K2 family");
        else check(same(first[i+1],generated && i/n<m/4*4 && i%n<n/8*8 ? fused : separate),
                   "actual source full-tile FMA versus separately rounded tail");
      } else check(same(first[i+1],expectedFirst[i]),"independent exact first math");
      check(same(retained.data()[i],first[i+1]),"owning observation matches publication");
    }
    if(!failed && !fmaCase)
      for(std::size_t i=0;i<outM*n;++i) check(same(last[i+1],expectedLast[i]),"noncommuting carry/late-read math");
  }
  check(first.front()==-777 && first.back()==-777 && last.front()==-888 && last.back()==-888,
        "all destination boundary sentinels preserved");
  check(a==savedA && b==savedB,"all mutable source inputs unchanged");
  if(m*n) {
    const float old=retained.data()[0];
    first[1]=999;
    check(same(retained.data()[0],old),"owning observation survives Result lifetime and resource mutation");
  }
}
}
int main(int argc,char **argv) {
  if(argc!=2) return 2;
  for(auto shape : {std::array<std::size_t,3>{4,8,2},{5,9,3},{8,8,5},
                   {0,8,2},{4,0,2},{4,8,0}}) {
    const auto [m,n,k]=shape;
    run(argv[1],m,n,k,false,false,false,false);
    run(argv[1],m,n,k,true,false,false,false);
  }
  run(argv[1],8,8,3,false,true,false,false);
  run(argv[1],8,8,3,false,true,true,false);
  run(argv[1],4,8,3,false,false,true,false);
  run(argv[1],4,8,3,true,false,false,true);
  run(argv[1],5,9,2,true,false,false,false,true);
  std::cout << "Generated reassociate source: " << checks << " checks; " << failures << " failures\n";
  return failures ? 1 : 0;
}
