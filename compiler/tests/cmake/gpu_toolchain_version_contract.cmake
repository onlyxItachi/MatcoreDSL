if(DEFINED GPU_VERSION_GATE_CHILD)
  # Execute the real production gate file. Only discovery, process output and
  # unrelated target/SDK setup are mocked; no copy of its version decisions is
  # used. Stop immediately after the selected gate, before artifact issuance.
  # A bypassed gate would admit a negative control and fail the parent test.
  function(find_package)
    if(NOT ARGV0 STREQUAL "Threads")
      message(FATAL_ERROR "Unexpected package discovery: ${ARGV}")
    endif()
  endfunction()
  function(find_program output)
    if(output STREQUAL "MDSLC_GPU_LLC")
      set(${output} mock-llc PARENT_SCOPE)
    elseif(output STREQUAL "MDSLC_PTXAS")
      set(${output} mock-ptxas PARENT_SCOPE)
    elseif(output STREQUAL "MDSLC_GPU_LLD")
      set(${output} mock-lld PARENT_SCOPE)
    else()
      message(FATAL_ERROR "Unexpected tool discovery: ${ARGV}")
    endif()
  endfunction()
  function(execute_process)
    if(NOT ARGC EQUAL 7 OR NOT ARGV0 STREQUAL "COMMAND" OR
       NOT ARGV2 STREQUAL "--version" OR
       NOT ARGV3 STREQUAL "OUTPUT_VARIABLE" OR
       NOT ARGV5 STREQUAL "COMMAND_ERROR_IS_FATAL" OR NOT ARGV6 STREQUAL "ANY")
      message(FATAL_ERROR "Unexpected tool execution: ${ARGV}")
    endif()
    if(ARGV1 STREQUAL "mock-${GPU_VERSION_TOOL}")
      set(${ARGV4} "${GPU_VERSION_BANNER}" PARENT_SCOPE)
      set(selected_tool_observed TRUE PARENT_SCOPE)
    elseif(ARGV1 STREQUAL "mock-llc")
      set(${ARGV4} "${llc_banner}" PARENT_SCOPE)
    else()
      message(FATAL_ERROR "Unexpected selected tool: ${ARGV1}")
    endif()
  endfunction()
  function(find_path output)
    set(${output} "/mock/include" PARENT_SCOPE)
  endfunction()
  function(find_library output)
    if(output STREQUAL "MDSLC_CUDA_DRIVER")
      set(${output} "/mock/libcuda.so.1" PARENT_SCOPE)
    elseif(output STREQUAL "MDSLC_HIP_RUNTIME")
      set(${output} "/mock/libamdhip64.so.7.2.70201" PARENT_SCOPE)
    else()
      message(FATAL_ERROR "Unexpected library discovery: ${ARGV}")
    endif()
  endfunction()
  function(file command)
    if(command STREQUAL "STRINGS" AND ARGV1 STREQUAL "/mock/include/cuda.h")
      set(${ARGV2} "#define CUDA_VERSION 13030" PARENT_SCOPE)
    elseif(command STREQUAL "REAL_PATH")
      set(${ARGV2} "${ARGV1}" PARENT_SCOPE)
    else()
      message(FATAL_ERROR "Unexpected file operation: ${ARGV}")
    endif()
  endfunction()
  macro(add_library)
    if(GPU_VERSION_TOOL STREQUAL "llc")
      set(gate_admitted TRUE)
      return()
    endif()
  endmacro()
  function(target_compile_features)
  endfunction()
  function(target_include_directories)
  endfunction()
  function(target_link_libraries)
  endfunction()
  function(mdslc_target_enable_warnings)
  endfunction()
  function(mdslc_target_match_llvm_rtti)
  endfunction()
  function(add_executable)
  endfunction()
  function(add_custom_target)
  endfunction()
  macro(add_custom_command)
    set(gate_admitted TRUE)
    return()
  endmacro()

  function(check_production_gate)
    set(MDSLC_ENABLE_EXPERIMENTAL_GPU_ISSUER ON)
    set(MDSLC_ENABLE_EXPERIMENTAL_REGIONS ON)
    set(MDSLC_ENABLE_EXPERIMENTAL_NVVM OFF)
    set(MDSLC_ENABLE_EXPERIMENTAL_ROCDL OFF)
    if(GPU_VERSION_TOOL STREQUAL "ptxas")
      set(MDSLC_ENABLE_EXPERIMENTAL_NVVM ON)
    elseif(GPU_VERSION_TOOL STREQUAL "lld")
      set(MDSLC_ENABLE_EXPERIMENTAL_ROCDL ON)
    endif()
    set(CMAKE_SYSTEM_NAME Linux)
    set(CMAKE_SYSTEM_PROCESSOR x86_64)
    set(MDSLC_REQUIRED_TOOLCHAIN_VERSION "21.1.8")
    include("${MDSLC_SOURCE_DIR}/lib/regions/GpuCandidates.cmake")
    if(NOT gate_admitted OR NOT selected_tool_observed)
      message(FATAL_ERROR "The selected production gate was not reached")
    endif()
    message(STATUS "GPU ${GPU_VERSION_TOOL} production gate admitted")
  endfunction()
  check_production_gate()
  return()
endif()

set(gpu_version_control_count 0)
function(check_gpu_version name tool banner expected_token expected_status)
  # Extraction checks distinguish a complete near-version token from silently
  # truncating it to the qualified version, as well as checking gate admission.
  mdslc_extract_gpu_tool_version_token("${tool}" "${banner}" token)
  if(NOT token STREQUAL expected_token)
    message(FATAL_ERROR
      "${name}: expected token '${expected_token}', got '${token}'")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DMDSLC_SOURCE_DIR=${MDSLC_SOURCE_DIR}" -DGPU_VERSION_GATE_CHILD=ON
    "-DGPU_VERSION_TOOL=${tool}" "-DGPU_VERSION_BANNER=${banner}"
    -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
    WORKING_DIRECTORY "${MDSLC_SOURCE_DIR}/lib/regions"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(NOT "${status}" STREQUAL "${expected_status}")
    message(FATAL_ERROR
      "${name}: expected exit ${expected_status}, got ${status}: ${output}\n${error}")
  endif()
  if(expected_status EQUAL 0)
    if(NOT output MATCHES "GPU ${tool} production gate admitted")
      message(FATAL_ERROR "${name}: missing gate admission marker: ${output}\n${error}")
    endif()
  elseif(NOT error MATCHES "GPU ${tool} qualification requires exactly" OR
         output MATCHES "production gate admitted")
    message(FATAL_ERROR "${name}: failed outside the version gate: ${output}\n${error}")
  endif()
  if(NOT expected_status EQUAL 0 AND NOT expected_token STREQUAL "")
    string(FIND "${error}" "reported '${expected_token}'" reported_position)
    if(reported_position EQUAL -1)
      message(FATAL_ERROR "${name}: diagnostic omitted the complete rejected token: ${error}")
    endif()
  endif()
  math(EXPR count "${gpu_version_control_count} + 1")
  set(gpu_version_control_count "${count}" PARENT_SCOPE)
endfunction()

check_gpu_version(llc_installed llc "${llc_banner}" "21.1.8" 0)
check_gpu_version(lld_installed lld "${lld_banner}" "21.1.8" 0)
check_gpu_version(ptxas_installed ptxas "${ptxas_banner}" "13.3.73" 0)

foreach(vendor IN ITEMS "" "Ubuntu " "Debian ")
  check_gpu_version(llc_vendor llc "${vendor}LLVM version 21.1.8" "21.1.8" 0)
  check_gpu_version(lld_vendor lld "${vendor}LLD 21.1.8 (compatible with GNU linkers)" "21.1.8" 0)
endforeach()
check_gpu_version(llc_multiline llc "LLVM (http://llvm.org/):\n  LLVM version 21.1.8\n  Optimized build." "21.1.8" 0)
check_gpu_version(llc_whitespace llc "\r\n\tUbuntu\tLLVM\tversion\t21.1.8 \r\n" "21.1.8" 0)
check_gpu_version(lld_whitespace lld "\r\n\tUbuntu\tLLD\t21.1.8 \r\n" "21.1.8" 0)
check_gpu_version(ptxas_whitespace ptxas "\r\n\t${ptxas_header}\r\n  Cuda\tcompilation tools,\trelease 13.3,\tV13.3.73\r\n" "13.3.73" 0)

foreach(tool IN ITEMS llc lld ptxas)
  if(tool STREQUAL "ptxas")
    set(required_version "13.3.73")
    set(prefix "${ptxas_header}\nCuda compilation tools, release 13.3, V")
    set(incidental_marker "V")
  elseif(tool STREQUAL "llc")
    set(required_version "21.1.8")
    set(prefix "Ubuntu LLVM version ")
    set(incidental_marker "LLVM version ")
  else()
    set(required_version "21.1.8")
    set(prefix "Ubuntu LLD ")
    set(incidental_marker "LLD ")
  endif()
  foreach(token IN ITEMS
      "${required_version}0" "1${required_version}" "${required_version}-rc1"
      "${required_version}git" "${required_version}+vendor" "${required_version}.1"
      "${required_version}(rc1)" "${required_version}," "${required_version};suffix"
      "v${required_version}" "21..8" "unknown")
    check_gpu_version("${tool}_near_or_malformed" "${tool}" "${prefix}${token}" "${token}" 1)
  endforeach()
  check_gpu_version("${tool}_empty" "${tool}" "" "" 1)
  check_gpu_version("${tool}_missing_token" "${tool}" "${prefix}\n" "" 1)
  check_gpu_version("${tool}_unrelated_occurrence" "${tool}" "Required version: ${required_version}\nnot a tool banner" "" 1)
  check_gpu_version("${tool}_wrong_then_unrelated_exact" "${tool}" "${prefix}99.0.0\nNote: ${incidental_marker}${required_version}" "99.0.0" 1)
  check_gpu_version("${tool}_duplicate_wrong_then_exact" "${tool}" "${prefix}99.0.0\n${prefix}${required_version}" "" 1)
  check_gpu_version("${tool}_duplicate_exact_then_wrong" "${tool}" "${prefix}${required_version}\n${prefix}99.0.0" "" 1)
  check_gpu_version("${tool}_duplicate_exact" "${tool}" "${prefix}${required_version}\n${prefix}${required_version}" "" 1)
endforeach()

check_gpu_version(llc_misleading_marker llc "Required LLVM version 21.1.8\nActual LLVM version 99.0.0" "" 1)
check_gpu_version(llc_split_marker llc "LLVM version\n21.1.8" "" 1)
check_gpu_version(llc_unknown_vendor llc "Unqualified LLVM version 21.1.8" "" 1)
check_gpu_version(lld_misleading_marker lld "Required LLD 21.1.8\nActual LLD 99.0.0" "" 1)
check_gpu_version(lld_split_marker lld "LLD\n21.1.8" "" 1)
check_gpu_version(lld_unknown_vendor lld "Unqualified LLD 21.1.8" "" 1)
check_gpu_version(ptxas_bare_token ptxas "V13.3.73" "" 1)
check_gpu_version(ptxas_other_tool ptxas "nvcc: NVIDIA (R) Cuda compiler driver\nCuda compilation tools, release 13.3, V13.3.73" "" 1)
check_gpu_version(ptxas_misleading_marker ptxas "${ptxas_header}\nBuilt with V13.3.73\nCuda compilation tools, release 99.0, V99.0.0" "99.0.0" 1)
check_gpu_version(ptxas_split_marker ptxas "${ptxas_header}\nCuda compilation tools, release 13.3,\nV13.3.73" "" 1)
check_gpu_version(ptxas_missing_v ptxas "${ptxas_header}\nCuda compilation tools, release 13.3, 13.3.73" "" 1)

message(STATUS "GPU toolchain versions: ${gpu_version_control_count}/${gpu_version_control_count} parser and production-gate controls passed")
