#include <matcore/region.h>
namespace mdsl = matcore::mdsl;
MATCORE_REGION
mdsl::Result hpc_region(mdsl::Storage A, mdsl::Storage B, mdsl::Storage C,
                        mdsl::Shape m, mdsl::Shape n, mdsl::Shape k) noexcept {
  auto a = mdsl::read(A, m, k);
  auto b = mdsl::read(B, k, n);
  auto c = mdsl::gemm(a, b, mdsl::Numerics::reassociate_f32);
  mdsl::publish(c, C);
  return mdsl::complete();
}
#include "region_host.h"
