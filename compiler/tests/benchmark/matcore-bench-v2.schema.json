{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matcoredsl.invalid/schema/matcore-bench-v2.json",
  "title": "MDSLC CPU GEMM benchmark report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "operation",
    "dtype",
    "accumulation_dtype",
    "layout",
    "environment",
    "configuration",
    "results"
  ],
  "properties": {
    "schema": {"const": "matcore.benchmark.cpu.gemm"},
    "version": {"const": 2},
    "operation": {"const": "matcore.gemm"},
    "dtype": {"const": "f32"},
    "accumulation_dtype": {"const": "f32"},
    "layout": {"const": "row-major-contiguous"},
    "environment": {"$ref": "#/$defs/environment"},
    "configuration": {"$ref": "#/$defs/configuration"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_family",
        "architecture",
        "compiler",
        "compiler_flags",
        "build_type",
        "cpu_model",
        "governor",
        "frequency_policy",
        "boost_state",
        "cpu_affinity",
        "hardware_threads",
        "source_commit",
        "timer_source",
        "timer_resolution_ns",
        "timestamp_unix_seconds",
        "capability_record",
        "capability_runtime_validation_source",
        "topology_record",
        "capability_record_version",
        "topology_record_version",
        "topology_discovery_complete",
        "logical_processors",
        "physical_cores",
        "numa_nodes",
        "persistent_execution_context",
        "execution_context_workers",
        "execution_context_workers_started",
        "execution_context_submissions",
        "available_processors",
        "worker_affinity_applied",
        "worker_affinity_source",
        "provider_name",
        "provider_version",
        "provider_config"
      ],
      "properties": {
        "os_family": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "compiler": {"type": "string", "minLength": 1},
        "compiler_flags": {"type": "string"},
        "build_type": {"type": "string", "minLength": 1},
        "cpu_model": {"type": "string", "minLength": 1},
        "governor": {"type": "string", "minLength": 1},
        "frequency_policy": {"type": "string", "minLength": 1},
        "boost_state": {"type": "string", "minLength": 1},
        "cpu_affinity": {"type": "string", "minLength": 1},
        "hardware_threads": {"type": "integer", "minimum": 0},
        "source_commit": {"type": "string", "minLength": 1},
        "timer_source": {"type": "string", "minLength": 1},
        "timer_resolution_ns": {"type": "integer", "minimum": 1},
        "timestamp_unix_seconds": {"type": "integer", "minimum": 0},
        "capability_record": {"type": "string", "minLength": 1},
        "capability_runtime_validation_source": {"type": "string", "minLength": 1},
        "topology_record": {"type": "string", "minLength": 1},
        "capability_record_version": {"const": 2},
        "topology_record_version": {"const": 1},
        "topology_discovery_complete": {"type": "boolean"},
        "logical_processors": {"type": "integer", "minimum": 0},
        "physical_cores": {"type": "integer", "minimum": 0},
        "numa_nodes": {"type": "integer", "minimum": 0},
        "persistent_execution_context": {"type": "boolean"},
        "execution_context_workers": {"type": "integer", "minimum": 0},
        "execution_context_workers_started": {"type": "integer", "minimum": 0},
        "execution_context_submissions": {"type": "integer", "minimum": 0},
        "available_processors": {"type": "integer", "minimum": 1},
        "worker_affinity_applied": {"type": "boolean"},
        "worker_affinity_source": {"type": "string", "minLength": 1},
        "provider_name": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "provider_config": {"type": "string"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "requested_variant",
        "requested_threads",
        "warmup_iterations",
        "measured_iterations",
        "alignment_bytes",
        "cache_mode",
        "allocation_mode",
        "packing_mode",
        "smt_policy",
        "affinity_policy",
        "maximum_memory_bytes",
        "timer_floor_ns",
        "seed",
        "compare_one_thread",
        "planner_regret"
      ],
      "properties": {
        "profile": {"enum": ["custom", "quick", "standard", "full"]},
        "requested_variant": {"type": "string", "minLength": 1},
        "requested_threads": {"type": "integer", "minimum": 1},
        "warmup_iterations": {"type": "integer", "minimum": 0},
        "measured_iterations": {"type": "integer", "minimum": 1},
        "alignment_bytes": {"type": "integer", "minimum": 4},
        "cache_mode": {"enum": ["hot", "cold"]},
        "allocation_mode": {"enum": ["reuse-workspace", "include-allocation"]},
        "packing_mode": {"enum": ["include-packing", "exclude-packing", "prepacked-b"]},
        "smt_policy": {"enum": ["physical-cores-only", "allow-smt"]},
        "affinity_policy": {"enum": ["none", "compact", "scatter", "local-first"]},
        "maximum_memory_bytes": {"type": "integer", "minimum": 1},
        "timer_floor_ns": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "compare_one_thread": {"type": "boolean"},
        "planner_regret": {"type": "boolean"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m",
        "n",
        "k",
        "requested_variant",
        "selected_variant",
        "selection_reason",
        "plan_diagnostic",
        "timing_scope",
        "complete_implementation_comparison",
        "planner_mode",
        "planner_version",
        "actual_threads",
        "workspace_bytes",
        "shared_workspace_bytes",
        "per_worker_workspace_bytes",
        "workspace_alignment",
        "prepacked_b_bytes",
        "packing_required",
        "supports_prepacked_b",
        "persistent_execution_context",
        "smt_policy",
        "affinity_policy",
        "worker_affinity_applied",
        "affinity_diagnostic",
        "alignment_bytes",
        "lhs_stride",
        "rhs_stride",
        "output_stride",
        "estimated_memory_bytes",
        "cache_mode",
        "allocation_mode",
        "packing_mode",
        "timing_valid",
        "timing_rejection_reason",
        "aggregate_repetitions",
        "minimum_seconds",
        "median_seconds",
        "p95_seconds",
        "gflops",
        "checksum",
        "expected_checksum",
        "correctness",
        "oracle_mode",
        "checked_elements",
        "maximum_absolute_error",
        "maximum_allowed_error",
        "correctness_reason",
        "scaling",
        "planner_regret"
      ],
      "properties": {
        "m": {"type": "integer", "minimum": 1},
        "n": {"type": "integer", "minimum": 1},
        "k": {"type": "integer", "minimum": 1},
        "requested_variant": {"type": "string", "minLength": 1},
        "selected_variant": {"type": "string", "minLength": 1},
        "selection_reason": {"type": "string", "minLength": 1},
        "plan_diagnostic": {"type": "string", "minLength": 1},
        "timing_scope": {"type": "string", "minLength": 1},
        "complete_implementation_comparison": {"type": "boolean"},
        "planner_mode": {"enum": ["automatic", "forced"]},
        "planner_version": {"const": 3},
        "actual_threads": {"type": "integer", "minimum": 1},
        "workspace_bytes": {"type": "integer", "minimum": 0},
        "shared_workspace_bytes": {"type": "integer", "minimum": 0},
        "per_worker_workspace_bytes": {"type": "integer", "minimum": 0},
        "workspace_alignment": {"type": "integer", "minimum": 1},
        "prepacked_b_bytes": {"type": "integer", "minimum": 0},
        "packing_required": {"type": "boolean"},
        "supports_prepacked_b": {"type": "boolean"},
        "persistent_execution_context": {"type": "boolean"},
        "smt_policy": {"enum": ["physical-cores-only", "allow-smt"]},
        "affinity_policy": {"enum": ["none", "compact", "scatter", "local-first"]},
        "worker_affinity_applied": {"type": "boolean"},
        "affinity_diagnostic": {"type": "string", "minLength": 1},
        "alignment_bytes": {"type": "integer", "minimum": 4},
        "lhs_stride": {"type": "integer", "minimum": 1},
        "rhs_stride": {"type": "integer", "minimum": 1},
        "output_stride": {"type": "integer", "minimum": 1},
        "estimated_memory_bytes": {"type": "integer", "minimum": 1},
        "cache_mode": {"enum": ["hot", "cold"]},
        "allocation_mode": {"enum": ["reuse-workspace", "include-allocation"]},
        "packing_mode": {"enum": ["include-packing", "exclude-packing", "prepacked-b"]},
        "timing_valid": {"type": "boolean"},
        "timing_rejection_reason": {"type": "string"},
        "aggregate_repetitions": {"type": "integer", "minimum": 1},
        "minimum_seconds": {"type": "number", "minimum": 0},
        "median_seconds": {"type": "number", "minimum": 0},
        "p95_seconds": {"type": "number", "minimum": 0},
        "gflops": {"type": "number", "minimum": 0},
        "checksum": {"type": "number"},
        "expected_checksum": {"type": "number"},
        "correctness": {"type": "boolean"},
        "oracle_mode": {"enum": ["full-double", "sampled-double-plus-checksum"]},
        "checked_elements": {"type": "integer", "minimum": 1},
        "maximum_absolute_error": {"type": "number", "minimum": 0},
        "maximum_allowed_error": {"type": "number", "minimum": 0},
        "correctness_reason": {"type": "string", "minLength": 1},
        "scaling": {"$ref": "#/$defs/scaling"},
        "planner_regret": {"$ref": "#/$defs/planner_regret"}
      }
    },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "valid",
        "baseline_variant",
        "one_thread_median_seconds",
        "speedup_over_one_thread",
        "parallel_efficiency",
        "reason"
      ],
      "properties": {
        "requested": {"type": "boolean"},
        "valid": {"type": "boolean"},
        "baseline_variant": {"type": "string"},
        "one_thread_median_seconds": {"type": "number", "minimum": 0},
        "speedup_over_one_thread": {"type": "number", "minimum": 0},
        "parallel_efficiency": {"type": "number", "minimum": 0},
        "reason": {"type": "string"}
      }
    },
    "regret_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "legal",
        "reason",
        "complete_implementation_comparison",
        "timing_valid",
        "correctness",
        "median_seconds",
        "measurement_reason"
      ],
      "properties": {
        "variant": {"type": "string", "minLength": 1},
        "legal": {"type": "boolean"},
        "reason": {"type": "string"},
        "complete_implementation_comparison": {"type": "boolean"},
        "timing_valid": {"type": "boolean"},
        "correctness": {"type": "boolean"},
        "median_seconds": {"type": "number", "minimum": 0},
        "measurement_reason": {"type": "string"}
      }
    },
    "planner_regret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "valid",
        "fastest_legal_variant",
        "fastest_legal_median_seconds",
        "selected_median_seconds",
        "regret",
        "reason",
        "candidates"
      ],
      "properties": {
        "requested": {"type": "boolean"},
        "valid": {"type": "boolean"},
        "fastest_legal_variant": {"type": "string"},
        "fastest_legal_median_seconds": {"type": "number", "minimum": 0},
        "selected_median_seconds": {"type": "number", "minimum": 0},
        "regret": {"type": "number", "minimum": 0},
        "reason": {"type": "string"},
        "candidates": {
          "type": "array",
          "items": {"$ref": "#/$defs/regret_candidate"}
        }
      }
    }
  }
}
