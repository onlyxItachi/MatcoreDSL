#include <matcore/region.h>
#include <bit>
#include <cstdint>
#include <cstdio>
#include <cstring>

namespace md = matcore::mdsl;
namespace left {
#include "shared_body.h"
}
namespace right {
#include "shared_body.h"
}

static constexpr unsigned failure_line = __LINE__ + 14;
MATCORE_REGION md::Result library_region(
    md::Storage A, md::Storage B, md::Storage C, md::Storage D,
    md::Shape M, md::Shape K, md::Shape N, md::Shape R,
    md::Shape P) noexcept {
  auto adjusted = right::passthrough(M);
  auto a = md::read(A, adjusted, K);
  auto b = md::read(B, K, N);
  auto old = md::read(C, M, N);
  auto first = left::product(a, b);
  md::publish(first, C);
  md::observe(C);
  auto late = md::read(D, R, P);
  // The nested product is dead mathematically, but its ordered check is live.
  auto second = right::keep_after_product(first, late, old);
  md::publish(second, C);
  md::observe(C);
  return md::complete();
}

static unsigned checks = 0, failures = 0;
static void check(bool good, const char *label) {
  ++checks;
  if (!good) { ++failures; std::fprintf(stderr, "FAIL: %s\n", label); }
}
static void values(const float *actual, const float *expected) {
  for (unsigned i = 0; i < 8; ++i)
    check(std::bit_cast<std::uint32_t>(actual[i]) ==
          std::bit_cast<std::uint32_t>(expected[i]), "exact matrix contents");
}
static void execute(bool late_failure) {
  float a[] = {1, 2, 3, 4, 5, 6};
  float b[] = {2, -1, 3, 1, 0, 4, -2, 2, 5, 2, 1, -3};
  float c[] = {17, 18, 19, 20, 21, 22, 23, 24};
  const float old[] = {17, 18, 19, 20, 21, 22, 23, 24};
  float d[25] = {};
  float expected[8] = {};
  for (unsigned i = 0; i < 2; ++i)
    for (unsigned j = 0; j < 4; ++j) {
      volatile float sum = 0.0f;
      for (unsigned k = 0; k < 3; ++k) {
        volatile float term = a[3 * i + k] * b[4 * k + j];
        sum = sum + term;
      }
      expected[4 * i + j] = sum;
    }
  const md::Shape r = late_failure ? 5 : 4;
  auto result = library_region(
      {a, 2, 3, 6, md::Access::read_only},
      {b, 3, 4, 12, md::Access::read_only},
      {c, 2, 4, 8, md::Access::read_write},
      {d, r, 5, 25, md::Access::read_only}, 2, 3, 4, r, 5);
  check(late_failure ? !result && result.error() == md::Error::shape_mismatch
                     : result.ok(), "defined success or retained dead-GEMM failure");
  check(result.publication_count() == (late_failure ? 1 : 2) &&
        result.observation_count() == (late_failure ? 1 : 2), "exact effect prefix");
  values(c, late_failure ? expected : old);
  auto first = result.observation(0);
  check(first.valid() && first.rows() == 2 && first.columns() == 4,
        "first owning observation shape");
  if (first.valid()) values(first.data(), expected);
  for (float &item : c) item = -71;
  if (first.valid()) values(first.data(), expected);
  if (late_failure) {
    check(result.failed_frontier() == 8 && result.completed_effect_frontier() == 6,
          "dead nested GEMM retains its frontier after publication and observation");
    const auto location = result.failure_location();
    check(location.file && std::strcmp(location.file, __FILE__) == 0,
          "failure belongs to physical outer main caller, not forged header path");
    check(location.line == failure_line && location.column == 17,
          "failure keeps outermost helper call coordinates");
  } else {
    auto second = result.observation(1);
    check(second.valid() && second.rows() == 2 && second.columns() == 4,
          "saved old Value observation shape");
    if (second.valid()) values(second.data(), old);
  }
}

int main() {
  check(left::passthrough(19) == 19 && right::passthrough(23) == 23,
        "Shape-only helpers retain ordinary host uses");
  execute(false);
  execute(true);
  if (!failures) std::printf("PASS library_repeated_include %u checks\n", checks);
  return failures ? 1 : 0;
}
