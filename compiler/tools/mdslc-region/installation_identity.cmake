foreach(path IN ITEMS CANDIDATES RUNTIME CLANG LINKER)
  if(NOT EXISTS "${${path}}")
    message(FATAL_ERROR "Missing compiler-owned ${path}: ${${path}}")
  endif()
  file(SHA256 "${${path}}" ${path}_SHA)
endforeach()
file(COPY_FILE "${RUNTIME}" "${OUTPUT}.runtime-install-image")
file(RPATH_REMOVE FILE "${OUTPUT}.runtime-install-image")
file(SHA256 "${OUTPUT}.runtime-install-image" INSTALLED_RUNTIME_SHA)
file(COPY_FILE "${CANDIDATES}" "${OUTPUT}.candidates-install-image")
file(RPATH_REMOVE FILE "${OUTPUT}.candidates-install-image")
file(SHA256 "${OUTPUT}.candidates-install-image" INSTALLED_CANDIDATES_SHA)
set(PROVIDER_SHA "")
if(PROVIDER)
  file(SHA256 "${PROVIDER}" PROVIDER_SHA)
endif()
file(WRITE "${OUTPUT}" "#pragma once\n#define REGION_CANDIDATES_SHA \"${CANDIDATES_SHA}\"\n#define REGION_INSTALLED_CANDIDATES_SHA \"${INSTALLED_CANDIDATES_SHA}\"\n#define REGION_RUNTIME_SHA \"${RUNTIME_SHA}\"\n#define REGION_INSTALLED_RUNTIME_SHA \"${INSTALLED_RUNTIME_SHA}\"\n")
file(APPEND "${OUTPUT}" "#define REGION_PROVIDER_SHA \"${PROVIDER_SHA}\"\n")
file(APPEND "${OUTPUT}" "#define REGION_CLANG_SHA \"${CLANG_SHA}\"\n#define REGION_LINKER_SHA \"${LINKER_SHA}\"\n")
