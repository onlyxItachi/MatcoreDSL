#include <matcore/mdsl.h>

namespace matcore::mdsl {
[[clang::annotate("matcore.op.gemm.mutated")]]
void gemm(out_arg, const matrix_view &, const matrix_view &, policy);
}

namespace md = matcore::mdsl;

void mutated_annotation(md::matrix_view &C, const md::matrix_view &A,
                        const md::matrix_view &B) {
  md::gemm(md::out(C), A, B);
}
