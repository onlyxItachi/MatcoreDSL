#include <matcore/mdsl.h>

int main() {
  float a_data[6] = {1, 2, 3, 4, 5, 6};
  float b_data[6] = {7, 8, 9, 10, 11, 12};
  float c_data[4] = {};
  matcore::mdsl::matrix_view a{a_data, 2, 3};
  matcore::mdsl::matrix_view b{b_data, 3, 2};
  matcore::mdsl::matrix_view c{c_data, 2, 2};
  matcore::mdsl::gemm(
      matcore::mdsl::out(c), a, b,
      matcore::mdsl::policy{.target = matcore::mdsl::target::cpu,
                            .fallback = matcore::mdsl::fallback::error});
  const float expected[4] = {58, 64, 139, 154};
  for (int index = 0; index < 4; ++index) {
    if (c_data[index] != expected[index]) {
      return 1;
    }
  }
  return 0;
}
