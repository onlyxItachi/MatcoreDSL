if(NOT DEFINED MDSLC_OBJDUMP OR NOT DEFINED MDSLC_RUNTIME)
  message(FATAL_ERROR "MDSLC_OBJDUMP and MDSLC_RUNTIME are required")
endif()

execute_process(
  COMMAND "${MDSLC_OBJDUMP}" -d -M intel "${MDSLC_RUNTIME}"
  RESULT_VARIABLE MDSLC_OBJDUMP_STATUS
  OUTPUT_VARIABLE MDSLC_DISASSEMBLY
  ERROR_VARIABLE MDSLC_OBJDUMP_ERROR
)
if(NOT MDSLC_OBJDUMP_STATUS EQUAL 0)
  message(FATAL_ERROR
    "objdump failed for ${MDSLC_RUNTIME}: ${MDSLC_OBJDUMP_ERROR}")
endif()

string(FIND "${MDSLC_DISASSEMBLY}" "compiler_vectorized_gemm" MDSLC_VECTOR_SYMBOL)
string(FIND "${MDSLC_DISASSEMBLY}" "ymm" MDSLC_YMM_INSTRUCTION)
if(MDSLC_VECTOR_SYMBOL EQUAL -1 OR MDSLC_YMM_INSTRUCTION EQUAL -1)
  message(FATAL_ERROR
    "x86 compiler-vectorized GEMM must contain an AVX YMM instruction")
endif()
