#include <matcore/mdsl.h>
namespace md = matcore::mdsl;

void two_gemm_region(md::matrix_view A, md::matrix_view B,
                     md::matrix_view C, md::matrix_view D,
                     md::matrix_view E) {
  md::gemm(md::out(C), A, B);
  md::gemm(md::out(E), C, D);
}

// Exact input aliasing is legal. One descriptor may occupy both input roles.
void aliased_inputs(md::matrix_view A, md::matrix_view C,
                    md::matrix_view D, md::matrix_view E) {
  md::gemm(md::out(C), A, A);
  md::gemm(md::out(E), C, D);
}

// For example: A(2x3)*B(3x4) -> C(2x4), D(5x2)*C(2x4) -> E(5x4).
// These are illustrative runtime dimensions, not inferred static source facts.
void rhs_carried(md::matrix_view A, md::matrix_view B,
                 md::matrix_view C, md::matrix_view D,
                 md::matrix_view E) {
  md::gemm(md::out(C), A, B);
  md::gemm(md::out(E), D, C);
}

// Already admitted before the RHS mirror: forward lhs, reload rhs after guard1.
void both_inputs_carried(md::matrix_view A, md::matrix_view B,
                         md::matrix_view C, md::matrix_view E) {
  md::gemm(md::out(C), A, B);
  md::gemm(md::out(E), C, C);
}
